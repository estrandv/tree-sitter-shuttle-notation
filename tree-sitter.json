{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "shuttle",
      "camelcase": "Shuttle",
      "title": "Shuttle Notation",
      "scope": "source.shuttle",
      "file-types": ["shuttle"],
      "injection-regex": "^shuttle",
      "class-name": "TreeSitterShuttleNotation",
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.3.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for Shuttle Notation",
    "authors": [
      {
        "name": "estrandv",
        "email": "emil.strandvik@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/estrandv/tree-sitter-shuttle-notation"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
